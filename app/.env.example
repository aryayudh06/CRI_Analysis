# Salin file ini menjadi .env lalu isi dengan API key Gemini Anda,
# atau langsung export sebagai environment variable sebelum menjalankan uvicorn.
#
# Dapatkan API key di https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Opsional -- model default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Opsional -- jeda minimum (detik) antar-panggilan Gemini TANPA Google Search grounding
# (dipakai /api/qualitative/risk-narrative). Default: 5
# GEMINI_MIN_INTERVAL_SECONDS=5

# Opsional -- jeda minimum (detik) antar-panggilan Gemini YANG PAKAI Google Search
# grounding (dipakai /api/qualitative/reputation). Kuota grounding biasanya jauh lebih
# ketat daripada generateContent biasa -- cek RPM riil di https://ai.dev/rate-limit lalu
# sesuaikan nilai ini. Default: 20
# GEMINI_GROUNDING_MIN_INTERVAL_SECONDS=20
